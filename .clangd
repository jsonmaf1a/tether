CompileFlags:
  Add:
    - -std=c++23
    - -Wall
    - -Wextra
  CompilationDatabase: build/
  Remove:
    - -fmodules-ts
    - -fmodule-mapper=*
    - -fdeps-format=*

Diagnostics:
  ClangTidy:
    FastCheckFilter: Strict
  UnusedIncludes: Strict

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true
  BlockEnd: false

Hover:
  ShowAKA: true
